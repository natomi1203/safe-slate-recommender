    @property
    def materialized_slate(self) -> list[int] | None: ...
    @property
    def k_lower(self) -> int: ...
    @property
    def k_upper(self) -> int: ...
    @property
    def cardinality_gap(self) -> int: ...
    @property
    def first_unresolved_depth(self) -> int | None: ...
    @property
    def upper_bound_source(self) -> str: ...
    @property
    def reward(self) -> float: ...
    @property
    def safety_mean(self) -> float: ...
    @property
    def safety_variance(self) -> float: ...
    @property
    def safety_lcb(self) -> float: ...
    @property
    def status(self) -> str: ...
    @property
    def stop_reason(self) -> str: ...
    @property
    def exact(self) -> bool: ...
    @property
    def rechecked(self) -> bool: ...
    @property
    def deadline_reached(self) -> bool: ...
    @property
    def expansions(self) -> int: ...
    @property
    def deepest_completed_depth(self) -> int: ...
    @property
    def incumbent_updates(self) -> int: ...
    @property
    def predicate_calls(self) -> int: ...
    @property
    def predicate_batches(self) -> int: ...
    @property
    def predicate_errors(self) -> int: ...
    @property
    def elapsed_seconds(self) -> float: ...

def optimize_slate(
    rewards: Sequence[float],
    safety_means: Sequence[float],
    safety_variances: Sequence[float],
    max_items: int,
    *,
    safety_threshold: float = 0.0,
    confidence_radius: float = 1.96,
    covariance: Sequence[Sequence[float]] | None = None,
    contrast_features: Sequence[Sequence[float]] | None = None,
    parameter_covariance: Sequence[Sequence[float]] | None = None,
    group_ids: Sequence[int] | None = None,
    group_caps: Mapping[int, int] | None = None,
    conflicts: Sequence[tuple[int, int]] | None = None,
    beam_width: int = 128,
    max_expansions: int = 100_000,
    timeout_ms: int = 1_000,
    custom_predicate: Callable[[list[int]], bool] | None = None,
    custom_predicate_batch: Callable[[list[list[int]]], Sequence[bool]] | None = None,
) -> CertifiedOracleResult: ...

def optimize_replacements(
    remove_positions: Sequence[int],
    add_item_ids: Sequence[int],
    reward_deltas: Sequence[float],
    safety_means: Sequence[float],
    safety_variances: Sequence[float],
    baseline_size: int,
    protected_count: int,
    max_replacements: int,
    *,
    safety_threshold: float = 0.0,
    confidence_radius: float = 1.96,
    covariance: Sequence[Sequence[float]] | None = None,
    contrast_features: Sequence[Sequence[float]] | None = None,
    parameter_covariance: Sequence[Sequence[float]] | None = None,
    baseline_item_ids: Sequence[int] | None = None,
    remove_group_ids: Sequence[int] | None = None,
    remove_group_caps: Mapping[int, int] | None = None,
    add_group_ids: Sequence[int] | None = None,
    add_group_caps: Mapping[int, int] | None = None,
    operation_conflicts: Sequence[tuple[int, int]] | None = None,
    beam_width: int = 128,
    max_expansions: int = 100_000,
    timeout_ms: int = 1_000,
    custom_predicate: Callable[[dict[str, object]], bool] | None = None,
    custom_predicate_batch: Callable[[list[dict[str, object]]], Sequence[bool]] | None = None,
) -> CertifiedReplacementResult: ...
