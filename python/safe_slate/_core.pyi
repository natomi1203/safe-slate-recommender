from collections.abc import Callable, Mapping, Sequence

class ProjectedContrastUncertainty:
    @property
    def covariance(self) -> list[list[float]]: ...
    @property
    def safety_variances(self) -> list[float]: ...
    @property
    def individual_lcbs(self) -> list[float]: ...
    @property
    def feature_dimension(self) -> int: ...

class PreparedLinearContrastMarginals:
    @property
    def safety_variances(self) -> list[float]: ...
    @property
    def feature_dimension(self) -> int: ...
    @property
    def contrast_features_sha256(self) -> str: ...
    @property
    def parameter_covariance_sha256(self) -> str: ...
    @property
    def matrix_digest_encoding(self) -> str: ...

def project_linear_contrast_uncertainty(
    safety_means: Sequence[float],
    contrast_features: Sequence[Sequence[float]],
    parameter_covariance: Sequence[Sequence[float]],
    *,
    confidence_radius: float = 1.96,
) -> ProjectedContrastUncertainty: ...

def project_linear_contrast_marginals(
    contrast_features: Sequence[Sequence[float]],
    parameter_covariance: Sequence[Sequence[float]],
) -> list[float]: ...

def prepare_linear_contrast_marginals_f64le(
    contrast_features: Sequence[Sequence[float]],
    parameter_covariance: Sequence[Sequence[float]],
) -> PreparedLinearContrastMarginals: ...

class CertifiedOracleResult:
    @property
    def selected_indices(self) -> list[int]: ...
    @property
    def k_lower(self) -> int: ...
    @property
    def k_upper(self) -> int: ...
    @property
    def cardinality_gap(self) -> int: ...
    @property
    def first_unresolved_depth(self) -> int | None: ...
    @property
    def upper_bound_source(self) -> str: ...
    @property
    def reward(self) -> float: ...
    @property
    def safety_mean(self) -> float: ...
    @property
    def safety_variance(self) -> float: ...
    @property
    def safety_lcb(self) -> float: ...
    @property
    def status(self) -> str: ...
    @property
    def stop_reason(self) -> str: ...
    @property
    def exact(self) -> bool: ...
    @property
    def rechecked(self) -> bool: ...
    @property
    def deadline_reached(self) -> bool: ...
    @property
    def expansions(self) -> int: ...
    @property
    def deepest_completed_depth(self) -> int: ...
    @property
    def incumbent_updates(self) -> int: ...
    @property
    def predicate_calls(self) -> int: ...
    @property
    def predicate_batches(self) -> int: ...
    @property
    def predicate_errors(self) -> int: ...
    @property
    def elapsed_seconds(self) -> float: ...

class CertifiedReplacementResult:
    @property
