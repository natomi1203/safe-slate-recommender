    {
      "paper_id": "certified-reranking-systems",
      "title": "Certified Re-ranking Systems Artifact and Public OPE Stress Test",
      "publication_status_at_snapshot": "blocked_external_evidence",
      "adoption_state": "stable_contracts_adopted",
      "capabilities": [
        {
          "capability_id": "protected-baseline-fail-closed-serving",
          "interfaces": [
            "safe_slate.optimize_replacements",
            "safe_slate.guarded_rerank",
            "safe_slate.guarded_candidate_pool_rerank"
          ],
          "adopted_contract": "Preserve the protected baseline core and return the unchanged baseline when required serving evidence or a final safety check fails.",
          "non_claim": "This contract does not establish production lift, calibration, latency, or external validity."
        },
        {
          "capability_id": "proposal-dominating-observability",
          "interfaces": [
            "safe_slate.guarded_rerank",
            "safe_slate.guarded_candidate_pool_rerank"
          ],
          "adopted_contract": "Record the proposal, served result, evidence gates, deadline state, and final-recheck outcome without treating a successful call as deployment evidence.",
          "non_claim": "A complete log is operational evidence only and is not a causal or safety result by itself."
        },
        {
          "capability_id": "immutable-offline-evaluation",
          "interfaces": [
            "safe_slate.audit_ope_readiness",
            "safe_slate.run_no_clobber_ope"
          ],
          "adopted_contract": "Bind OPE to immutable input identities, settled-label and support gates, frozen thresholds, and no-clobber evidence publication.",
          "non_claim": "Readiness and a verified bundle do not authorize rollout or convert partial support into a population point estimand."
        }
      ]
    },
    {
      "paper_id": "certified-slate-oracle",
      "title": "Certified Anytime Slate Oracles with Fail-Closed Safety",
      "publication_status_at_snapshot": "blocked_external_evidence",
      "adoption_state": "stable_contracts_adopted",
      "capabilities": [
        {
          "capability_id": "certified-anytime-cardinality",
          "interfaces": [
            "safe_slate.optimize_slate",
            "safe_slate.optimize_replacements"
          ],
          "adopted_contract": "Return a rechecked incumbent and an explicit lower and upper cardinality certificate when search stops early.",
          "non_claim": "An open certificate interval is not an exact optimum or a paper-level empirical result."
        },
        {
          "capability_id": "nonmonotone-constraint-correctness",
          "interfaces": [
            "safe_slate.optimize_slate"
          ],
          "adopted_contract": "Do not prune every descendant merely because a non-monotone whole-slate predicate rejects a partial slate.",
          "non_claim": "The callback contract does not provide a general tractability guarantee for arbitrary constraints."
        },
        {
          "capability_id": "shared-linear-uncertainty",
          "interfaces": [
            "safe_slate.optimize_slate",
            "safe_slate.guarded_candidate_pool_rerank"
          ],
          "adopted_contract": "Retain covariance between operations and reject malformed, non-finite, asymmetric, or non-positive-semidefinite uncertainty inputs.",
          "non_claim": "Input validation does not prove that an upstream uncertainty model is calibrated under deployment shift."
        },
        {
          "capability_id": "mandatory-final-recheck",
          "interfaces": [
            "safe_slate.optimize_slate",
            "safe_slate.optimize_replacements",
            "safe_slate.guarded_rerank",
            "safe_slate.guarded_candidate_pool_rerank"
          ],
          "adopted_contract": "Re-evaluate the selected incumbent before returning it and fail closed when callback execution or the final check is unsuccessful.",
          "non_claim": "The cooperative timeout is not a hard service deadline and requires an external deadline boundary."
        }
      ]
    }
  ],
